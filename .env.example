# gifthub-rust-ai configuration. Copy to `.env` (gitignored) and fill in.

# --- Redis (the Django <-> Rust boundary) ---
REDIS_URL=redis://127.0.0.1:6379/0      # required
# AI_JOBS_KEY=ai_jobs                    # list Django RPUSHes jobs onto (popped FIFO via BLPOP)
# AI_RESULT_PREFIX=ai_result:           # result key is {prefix}{job_id}
# AI_RESULT_TTL_SECS=300                # result key TTL
# POP_TIMEOUT_SECS=5                    # blocking-pop timeout (shutdown responsiveness)

# --- Worker tuning ---
# MAX_CONCURRENCY=4                     # max concurrent upstream LLM calls
# CONNECT_TIMEOUT_SECS=15
# REQUEST_TIMEOUT_SECS=60
# MAX_ATTEMPTS_PER_PROVIDER=2           # transient-only retries before failing over
# RUST_LOG=info                         # env_logger filter

# --- Providers (ordered failover list; each NAME is config-driven) ---
AI_PROVIDERS=cloudflare,openrouter,google   # required, comma-separated, in failover order
# AI_DEFAULT_RPM=20                     # per-provider default if NAME_RPM unset
# AI_DEFAULT_RPD=1000                   # per-provider default if NAME_RPD unset

# Cloudflare Workers AI (OpenAI-compat). BASE_URL embeds your account id.
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
CLOUDFLARE_API_KEY=<REDACTED>
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_MAX_TOKENS=4096               # REQUIRED: Cloudflare truncates at ~256 tokens without it
# CLOUDFLARE_RPM=20
# CLOUDFLARE_RPD=170                    # ~170 free llama calls/day at ~58.7 neurons each

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=<REDACTED>
OPENROUTER_MODEL=<model-id>
# OPENROUTER_RPM=20
# OPENROUTER_RPD=1000

# Google AI Studio (OpenAI-compat). Define MULTIPLE accounts per kind — same base URL + key,
# different models — and route tasks to them. Benchmarked clean at Turkmen (no Turkic-language
# contamination): gemini-3.1-flash-lite (fast/cheap) and gemini-2.5-flash. Keep RPM low (5) to be
# polite to Google AI Studio; the worker self-throttles via the per-provider rpm/rpd buckets.
GEMINI_LITE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_LITE_API_KEY=<REDACTED>
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# GEMINI_LITE_RPM=5
# GEMINI_LITE_RPD=1500
GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_FLASH_API_KEY=<REDACTED>
GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_FLASH_RPM=5
# GEMINI_FLASH_RPD=1500

# --- Per-task failover chains (optional; default = AI_PROVIDERS order) ---
# Any `AI_CHAIN_<TASK>` defines the failover chain for jobs whose `purpose` == <task> (lowercased):
# generator / translator / reviewer (legacy writer / judge still work). Providers in failover order;
# unknown names are ignored. `AI_CHAIN_DEFAULT` is the fallback for any unmatched purpose.
# Content correctness (Turkmen especially) is the priority, so for now ALL content chains are
# Gemini-only — we deliberately do NOT fall back to gemma (openrouter) or llama (cloudflare). If
# Gemini is unavailable the job fails and Django defers the draft for a later retry, rather than
# shipping worse output. (Add cloudflare/openrouter back to a chain only when you want that tradeoff.)
# AI_CHAIN_GENERATOR=gemini_lite,gemini_flash
# AI_CHAIN_TRANSLATOR=gemini_lite,gemini_flash
# AI_CHAIN_REVIEWER=gemini_flash,gemini_lite
# AI_CHAIN_DEFAULT=gemini_lite,gemini_flash
